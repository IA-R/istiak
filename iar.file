step :02
________
	
	python -m http.server 8000
	//(press ctrl+c to stop the server)
	 git init 
	git config --global user.name your name on github
	git comfig --global user.email your mail on github
	git add .
	git commit -m ("anyting you want to you can write") 
	git branch -M main
	git remote add origin https://your repository http link
 //(if you used it before or it
	than use get git remote get-url origin https://your repository http link)
	git push -u origin main
